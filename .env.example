# Gemini AI Configuration for Self-Order Chef Assistant
# Get your API key from: https://aistudio.google.com/apikey
#
# SECURITY: the API key must NOT be exposed to the browser. Do NOT use a
# VITE_GEMINI_API_KEY var — any VITE_* value is embedded in the client bundle
# and is publicly extractable. Instead, set GEMINI_API_KEY on the Directus
# server and deploy the directus-extensions/endpoints/gemini-proxy endpoint,
# which injects the key server-side (see that folder's README).

# Gemini Model (default: gemini-2.0-flash). This is not secret, so it MAY be
# set as a VITE_* var to override the client-side default.
# Other options: gemini-1.5-flash, gemini-2.0-flash, gemini-pro
VITE_GEMINI_MODEL=gemini-2.0-flash

# Set these on the Directus SERVER (not here):
#   GEMINI_API_KEY=your_gemini_api_key_here
#   GEMINI_MODEL=gemini-2.0-flash        # optional, overrides default
#   GEMINI_PROXY_ENABLED=true            # optional, set to false to disable
